<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="internal-nlog.txt">

  <!-- Targets: where to log (e.g., file, console) -->
  <targets>
    <target xsi:type="File" name="logfile" fileName="logs/app.log" layout="${longdate}|${level:uppercase=true}|${logger}|${message}" />
    <target xsi:type="Console" name="logconsole" layout="${longdate}|${level:uppercase=true}|${logger}|${message}" />
  </targets>

  <!-- Rules: what to log and where -->
  <rules>
    <!-- Only log Warning and Error levels -->
    <logger name="*" minLevel="Warn" writeTo="logfile,logconsole" />
  </rules>
</nlog>
